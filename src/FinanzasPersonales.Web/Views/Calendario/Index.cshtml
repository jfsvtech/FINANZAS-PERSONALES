@model CalendarioFinancieroVm
@{
    ViewBag.Titulo = "Calendario financiero";
    var anterior = Model.PrimerDia.AddMonths(-1);
    var siguiente = Model.PrimerDia.AddMonths(1);
    var offset = ((int)Model.PrimerDia.DayOfWeek + 6) % 7;
    var eventosPorDia = Model.EventosMes.GroupBy(x => x.Fecha.Day).ToDictionary(x => x.Key, x => x.ToList());
}

<div class="page-heading d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <span class="page-eyebrow">Agenda unificada</span>
        <h3 class="mb-1"><i class="bi bi-calendar3 text-warning"></i> Calendario financiero</h3>
        <p class="text-muted mb-0">Tarjetas, gastos, cobros, metas y retornos en un solo lugar.</p>
    </div>
    <div class="btn-group">
        <a class="btn btn-outline-primary" asp-route-anio="@anterior.Year" asp-route-mes="@anterior.Month"><i class="bi bi-chevron-left"></i></a>
        <span class="btn btn-primary text-capitalize" style="pointer-events:none">@Model.Periodo</span>
        <a class="btn btn-outline-primary" asp-route-anio="@siguiente.Year" asp-route-mes="@siguiente.Month"><i class="bi bi-chevron-right"></i></a>
    </div>
</div>

<div class="calendar-layout">
    <div class="card calendar-card">
        <div class="calendar-scroll">
            <div class="calendar-weekdays"><span>Lun</span><span>Mar</span><span>Mie</span><span>Jue</span><span>Vie</span><span>Sab</span><span>Dom</span></div>
            <div class="calendar-grid">
                @for (var n = 0; n < offset; n++)
                {
                    <div class="calendar-day calendar-empty"></div>
                }
                @for (var dia = 1; dia <= Model.DiasMes; dia++)
                {
                    var fecha = new DateTime(Model.Anio, Model.Mes, dia);
                    var esHoy = fecha == DateTime.Today;
                    var eventos = eventosPorDia.GetValueOrDefault(dia) ?? new();
                    <div class="calendar-day @(esHoy ? "calendar-today" : "")" role="button" tabindex="0" data-calendar-day="@fecha.ToString("yyyy-MM-dd")">
                        <span class="calendar-number">@dia</span>
                        <div class="calendar-events">
                            @foreach (var e in eventos.Take(4))
                            {
                                <a href="@e.Url"
                                   class="calendar-event"
                                   style="--event-color:@e.Color"
                                   title="@e.Titulo - @e.Detalle"
                                   data-calendar-action="@(string.IsNullOrWhiteSpace(e.UrlSecundaria) ? "direct" : "choose")"
                                   data-title="@e.ModalTitulo"
                                   data-event="@e.Titulo"
                                   data-detail="@e.Detalle"
                                   data-primary="@e.AccionTexto"
                                   data-primary-url="@e.Url"
                                   data-secondary="@e.AccionSecundariaTexto"
                                   data-secondary-url="@e.UrlSecundaria">
                                    <i class="bi @e.Icono"></i><span>@e.Titulo</span>
                                </a>
                            }
                            @if (eventos.Count > 4)
                            {
                                <button type="button" class="calendar-more" data-calendar-more="@fecha.ToString("yyyy-MM-dd")">+@(eventos.Count - 4) mas</button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card upcoming-card">
        <div class="card-header d-flex justify-content-between">
            <strong><i class="bi bi-bell"></i> Proximos 60 dias</strong>
            <span class="badge text-bg-warning">@Model.ProximosEventos.Count</span>
        </div>
        <div class="list-group list-group-flush">
            @foreach (var e in Model.ProximosEventos)
            {
                <div class="list-group-item calendar-upcoming">
                    <span class="calendar-date"><strong>@e.Fecha.Day</strong><small>@e.Fecha.ToString("MMM")</small></span>
                    <span class="calendar-upcoming-icon" style="color:@e.Color;background:color-mix(in srgb,@e.Color 14%,transparent)"><i class="bi @e.Icono"></i></span>
                    <span class="flex-grow-1">
                        <strong class="d-block">@e.Titulo</strong>
                        <small class="text-muted">@e.Detalle@if (e.Monto.HasValue){<text> - @e.Monto.Value.ToString("C0")</text>}</small>
                    </span>
                    <a class="btn btn-sm btn-outline-primary"
                       href="@e.Url"
                       data-calendar-action="@(string.IsNullOrWhiteSpace(e.UrlSecundaria) ? "direct" : "choose")"
                       data-title="@e.ModalTitulo"
                       data-event="@e.Titulo"
                       data-detail="@e.Detalle"
                       data-primary="@e.AccionTexto"
                       data-primary-url="@e.Url"
                       data-secondary="@e.AccionSecundariaTexto"
                       data-secondary-url="@e.UrlSecundaria">@e.AccionTexto</a>
                </div>
            }
            @if (!Model.ProximosEventos.Any())
            {
                <div class="list-group-item text-center text-muted py-5">No hay eventos durante los proximos 60 dias.</div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="modalAccionCalendario" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="calModalTitulo">Accion del calendario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h6 id="calModalEvento" class="mb-1"></h6>
                <p id="calModalDetalle" class="text-muted mb-0"></p>
                <div class="alert alert-info mt-3 mb-0">
                    Puedes registrar el movimiento puntual o ir a la configuracion recurrente para ajustarlo antes.
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-outline-primary" id="calModalSecundaria" href="#">Ver recurrente</a>
                <a class="btn btn-premium" id="calModalPrimaria" href="#">Registrar</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDiaCalendario" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalle del dia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h6 id="diaModalFecha" class="mb-1"></h6>
                <p class="text-muted mb-3">Revisa todos los compromisos del dia o crea un recurrente nuevo con esta fecha programada.</p>
                <div id="diaModalEventos" class="calendar-day-detail-list"></div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-outline-primary" id="diaModalIngreso" href="#"><i class="bi bi-arrow-down-circle"></i> Ingreso recurrente</a>
                <a class="btn btn-premium" id="diaModalGasto" href="#"><i class="bi bi-arrow-up-circle"></i> Gasto recurrente</a>
            </div>
        </div>
    </div>
</div>

<style>
.calendar-day:not(.calendar-empty){cursor:pointer;transition:background var(--transition),box-shadow var(--transition)}
.calendar-day:not(.calendar-empty):hover{box-shadow:inset 0 0 0 2px rgba(124,58,237,.18);background:var(--purple-tint)}
.calendar-event{cursor:pointer}
.calendar-more{border:0;background:transparent;color:var(--purple);font-size:.68rem;font-weight:800;text-align:left;padding:.1rem .2rem}
.calendar-day-detail-list{display:grid;gap:.65rem;max-height:58vh;overflow:auto;padding-right:.25rem}
.calendar-day-detail-item{display:grid;grid-template-columns:auto 1fr auto;gap:.75rem;align-items:center;padding:.75rem;border:1px solid var(--border);border-radius:14px;background:var(--surface-2)}
.calendar-day-detail-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;color:var(--event-color);background:color-mix(in srgb,var(--event-color) 14%,transparent)}
.calendar-day-detail-item small{display:block;color:var(--muted)}
@@media(max-width:768px){.calendar-day-detail-item{grid-template-columns:auto 1fr}.calendar-day-detail-item .btn{grid-column:1/-1;width:100%}}
</style>

@section Scripts {
<script>
const accionModal = new bootstrap.Modal(document.getElementById('modalAccionCalendario'));
const diaModal = new bootstrap.Modal(document.getElementById('modalDiaCalendario'));
const periodicosBaseUrl = '@Url.Action("Index", "Periodicos")';
const eventosPorDia = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    eventosPorDia.ToDictionary(
        x => new DateTime(Model.Anio, Model.Mes, x.Key).ToString("yyyy-MM-dd"),
        x => x.Value.Select(e => new {
            fecha = e.Fecha.ToString("yyyy-MM-dd"),
            tipo = e.Tipo,
            icono = e.Icono,
            titulo = e.Titulo,
            detalle = e.Detalle,
            monto = e.Monto,
            color = e.Color,
            url = e.Url,
            accion = e.AccionTexto,
            secundaria = e.AccionSecundariaTexto,
            secundariaUrl = e.UrlSecundaria,
            modalTitulo = e.ModalTitulo
        })
    )));
document.querySelectorAll('[data-calendar-action="choose"]').forEach(link => {
    link.addEventListener('click', event => {
        event.preventDefault();
        document.getElementById('calModalTitulo').textContent = link.dataset.title || 'Accion del calendario';
        document.getElementById('calModalEvento').textContent = link.dataset.event || '';
        document.getElementById('calModalDetalle').textContent = link.dataset.detail || '';
        const primaria = document.getElementById('calModalPrimaria');
        const secundaria = document.getElementById('calModalSecundaria');
        primaria.textContent = link.dataset.primary || 'Registrar';
        primaria.href = link.dataset.primaryUrl || '#';
        secundaria.textContent = link.dataset.secondary || 'Ver recurrente';
        secundaria.href = link.dataset.secondaryUrl || '#';
        accionModal.show();
    });
});
function abrirDiaCalendario(day){
    const fecha = new Date(day + 'T00:00:00');
    document.getElementById('diaModalFecha').textContent = fecha.toLocaleDateString('es-CO', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
    document.getElementById('diaModalGasto').href = `${periodicosBaseUrl}?nuevo=true&fecha=${encodeURIComponent(day)}&tipo=gasto`;
    document.getElementById('diaModalIngreso').href = `${periodicosBaseUrl}?nuevo=true&fecha=${encodeURIComponent(day)}&tipo=ingreso`;
    const contenedor = document.getElementById('diaModalEventos');
    const eventos = eventosPorDia[day] || [];
    if(!eventos.length){
        contenedor.innerHTML = '<div class="empty-state py-4"><i class="bi bi-calendar-plus"></i>Este dia no tiene eventos programados.</div>';
    }else{
        contenedor.innerHTML = eventos.map((e,idx)=>`
            <div class="calendar-day-detail-item" style="--event-color:${e.color || '#7C3AED'}">
                <span class="calendar-day-detail-icon"><i class="bi ${e.icono || 'bi-calendar-event'}"></i></span>
                <span>
                    <strong>${escapeHtml(e.titulo || '')}</strong>
                    <small>${escapeHtml(e.detalle || '')}${e.monto ? ' - ' + formatMoney(e.monto) : ''}</small>
                </span>
                <span class="d-flex gap-2 flex-wrap justify-content-end">
                    ${e.secundariaUrl ? `<a class="btn btn-sm btn-outline-primary" href="${e.secundariaUrl}">${escapeHtml(e.secundaria || 'Ver')}</a>` : ''}
                    <a class="btn btn-sm btn-primary" href="${e.url || '#'}">${escapeHtml(e.accion || 'Ver detalle')}</a>
                </span>
            </div>`).join('');
    }
    diaModal.show();
}
function escapeHtml(value){
    return (value ?? '').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
}
function formatMoney(value){
    return new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',maximumFractionDigits:0}).format(Number(value || 0));
}
document.querySelectorAll('[data-calendar-day]').forEach(day => {
    day.addEventListener('click', event => {
        if (event.target.closest('a')) return;
        abrirDiaCalendario(day.dataset.calendarDay);
    });
    day.addEventListener('keydown', event => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        abrirDiaCalendario(day.dataset.calendarDay);
    });
});
document.querySelectorAll('[data-calendar-more]').forEach(btn => {
    btn.addEventListener('click', event => {
        event.preventDefault();
        event.stopPropagation();
        abrirDiaCalendario(btn.dataset.calendarMore);
    });
});
</script>
}
