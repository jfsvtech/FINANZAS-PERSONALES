@model ConciliacionVm
@{
    ViewBag.Titulo = "Conciliacion de cuentas";
}

<div class="page-heading mb-3">
    <span class="page-eyebrow">Control de saldos</span>
    <h3 class="mb-1"><i class="bi bi-check2-square text-primary"></i> Conciliacion de cuentas</h3>
    <p class="text-muted mb-0">Compara el saldo calculado por el sistema contra el saldo real del banco, efectivo o tarjeta.</p>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-header fw-bold"><i class="bi bi-bank"></i> Nueva conciliacion</div>
            <div class="card-body">
                <form method="post" asp-action="Guardar">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Cuenta</label>
                        <select name="cuentaId" class="form-select" required>
                            @foreach (var c in Model.Cuentas)
                            {
                                <option value="@c.Id">@c.Nombre - sistema @c.Saldo.ToString("C0")</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Saldo real</label>
                        <input name="saldoReal" class="form-control" required />
                        <div class="form-text">Escribe el saldo que ves en el banco, caja o extracto de tarjeta.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fecha</label>
                        <input name="fecha" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notas</label>
                        <textarea name="notas" class="form-control" rows="2" maxlength="400"></textarea>
                    </div>
                    <button class="btn btn-primary w-100"><i class="bi bi-check2-circle"></i> Guardar conciliacion</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-bold"><i class="bi bi-wallet2"></i> Saldos actuales del sistema</div>
            <div class="card-body">
                <div class="row g-2">
                    @foreach (var c in Model.Cuentas)
                    {
                        <div class="col-12 col-md-6">
                            <div class="home-action-card">
                                <span class="home-action-icon bg-primary-subtle text-primary"><i class="bi @c.Icono"></i></span>
                                <span><strong>@c.Nombre</strong><small>@c.TipoTexto</small></span>
                                <span class="fw-bold @(c.Saldo>=0?"text-primary":"text-danger")">@c.Saldo.ToString("C0")</span>
                            </div>
                        </div>
                    }
                    @if (!Model.Cuentas.Any()) { <div class="empty-state"><i class="bi bi-bank"></i>No hay cuentas activas para conciliar.</div> }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header fw-bold"><i class="bi bi-clock-history"></i> Ultimas conciliaciones</div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Fecha</th><th>Cuenta</th><th class="text-end">Sistema</th><th class="text-end">Real</th><th class="text-end">Diferencia</th><th>Notas</th></tr></thead>
            <tbody>
            @foreach (var h in Model.Historial)
            {
                <tr>
                    <td>@h.Fecha.ToString("dd MMM yyyy")</td>
                    <td><i class="bi @h.CuentaIcono text-primary"></i> @h.CuentaNombre</td>
                    <td class="text-end">@h.SaldoSistema.ToString("C0")</td>
                    <td class="text-end">@h.SaldoReal.ToString("C0")</td>
                    <td class="text-end fw-bold @(Math.Abs(h.Diferencia)<=1?"text-success":"text-danger")">@h.Diferencia.ToString("C0")</td>
                    <td class="text-muted small">@h.Notas</td>
                </tr>
            }
            @if (!Model.Historial.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">Aun no hay conciliaciones guardadas.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
