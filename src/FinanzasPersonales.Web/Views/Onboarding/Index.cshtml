@model OnboardingVm
@{
    ViewBag.Titulo = "Configuracion inicial";
}

<div class="portal-hero mb-4">
    <div>
        <span class="portal-kicker">Primeros pasos</span>
        <h2 class="mb-1">Configura tu espacio financiero</h2>
        <p class="mb-0 opacity-75">Deja lista tu moneda, recordatorios, cuentas, categorias y primer registro.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <span class="page-eyebrow">Paso 1</span>
                <h5>Preferencias</h5>
                <form method="post" asp-action="GuardarPreferencias">
                    @Html.AntiForgeryToken()
                    <label class="form-label">Idioma</label>
                    <select name="idioma" class="form-select mb-3">
                        <option value="es" selected="@(Model.Idioma == "es")">Espanol</option>
                        <option value="en" selected="@(Model.Idioma == "en")">English</option>
                        <option value="pt" selected="@(Model.Idioma == "pt")">Portugues</option>
                    </select>
                    <label class="form-label">Moneda base</label>
                    <select name="monedaCodigo" class="form-select mb-3">
                        @foreach (var moneda in new[] { "COP", "USD", "EUR", "BRL" })
                        {
                            <option value="@moneda" selected="@(Model.MonedaCodigo == moneda)">@moneda</option>
                        }
                    </select>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="recordatoriosEmailActivos" value="true" id="recActivos" @(Model.RecordatoriosEmailActivos ? "checked" : "") />
                        <label class="form-check-label" for="recActivos">Recordatorios por correo</label>
                    </div>
                    <label class="form-label">Dias antes</label>
                    <input type="number" name="recordatoriosEmailDiasAntes" min="0" max="60" class="form-control mb-3" value="@Model.RecordatoriosEmailDiasAntes" />
                    <button class="btn btn-primary w-100">Guardar preferencias</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <span class="page-eyebrow">Paso 2</span>
                <h5>Cuentas y categorias base</h5>
                <p class="text-muted small">Creamos efectivo, cuenta principal, tarjeta de credito y categorias comunes. Luego puedes editarlas.</p>
                <div class="mb-3">
                    <span class="badge @(Model.TieneCuentas ? "text-bg-success" : "text-bg-warning")">Cuentas @(Model.TieneCuentas ? "listas" : "pendientes")</span>
                    <span class="badge @(Model.TieneCategorias ? "text-bg-success" : "text-bg-warning")">Categorias @(Model.TieneCategorias ? "listas" : "pendientes")</span>
                </div>
                <form method="post" asp-action="CrearBase">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-primary w-100"><i class="bi bi-magic"></i> Crear base inicial</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <span class="page-eyebrow">Paso 3</span>
                <h5>Primer movimiento</h5>
                <p class="text-muted small">Registra tu saldo inicial o primer gasto para que los tableros empiecen a tener sentido.</p>
                <div class="mb-3">
                    <span class="badge @(Model.TieneMovimiento ? "text-bg-success" : "text-bg-warning")">Movimiento @(Model.TieneMovimiento ? "registrado" : "pendiente")</span>
                </div>
                <a class="btn btn-outline-primary w-100 mb-2" asp-controller="Movimientos" asp-action="Index" asp-route-nuevo="true"><i class="bi bi-plus-lg"></i> Registrar movimiento</a>
                <form method="post" asp-action="Finalizar">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-premium w-100" @(Model.TieneCuentas && Model.TieneCategorias ? "" : "disabled")>
                        <i class="bi bi-check-circle"></i> Finalizar configuracion
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
